{
	"name": "shopify-cloudflare-boilerplate",
	"description": "Shopify embedded app boilerplate on Cloudflare Workers — Hono, Vite, React, D1, Durable Objects, Queues, R2",
	"dependencies": {
		"@shopify/shopify-api": "^14.0.0",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@eslint/js": "9.39.1",
		"@shopify/app-bridge-types": "^0.7.2",
		"@shopify/polaris-types": "^1.0.7",
		"@types/node": "24.10.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "5.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vitest": "^4.1.11",
		"wrangler": "4.123.0"
	},
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"check": "tsc -b && vite build && wrangler deploy --dry-run",
		"deploy": "npm run build && wrangler deploy",
		"db:generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs",
		"db:migrate": "curl -fsS \"$APP_URL/api/health\"",
		"shopify:dev": "shopify app dev",
		"shopify:deploy": "shopify app deploy",
		"test": "vitest run",
		"lint": "eslint .",
		"cf-typegen": "wrangler types"
	},
	"type": "module"
}
